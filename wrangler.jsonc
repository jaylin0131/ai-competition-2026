// Cloudflare Workers 部署設定。name 必須和 Cloudflare 上的 Worker 名稱相同。
// 秘密（SUPABASE_SERVICE_KEY）只在 Cloudflare 控制台設定，不要寫進這個檔案。
{
  "name": "ai-competition-schedule",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "site/dist",
    "binding": "ASSETS",
    // /api/status、/config.js 交給 Worker，其餘直接回傳網頁
    "run_worker_first": ["/api/*", "/config.js"]
  },
  // 保留在控制台設定的變數，部署時不會被清掉
  "keep_vars": true,
  "observability": { "enabled": true }
}
