// Cloudflare Workers 部署設定。name 必須和 Cloudflare 上的 Worker 名稱相同。
// 秘密（SITE_PASSWORD、SUPABASE_SERVICE_KEY）只在 Cloudflare 控制台設定，不要寫進這個檔案。
{
  "name": "ai-competition-schedule",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "site/dist",
    "binding": "ASSETS",
    // 每個請求（包含網頁本身）都先經過 Worker 檢查團隊密碼
    "run_worker_first": true
  },
  // 保留在控制台設定的變數，部署時不會被清掉
  "keep_vars": true,
  "observability": { "enabled": true }
}
